# Resend (release-update contact collection; does not send emails by itself)
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_AUDIENCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Enable only after `pnpm resend:contact-properties:ensure` succeeds.
RESEND_ACQUISITION_PROPERTIES_ENABLED=0

# Optional first-party anonymous operation counts. Disabled until dedicated
# durable storage is provisioned and publication is explicitly approved.
NEXT_PUBLIC_SITE_EVENTS_ENABLED=0
SITE_EVENTS_ENABLED=0
# Supabase REST storage (server-only; never use NEXT_PUBLIC_* for these keys).
# Prefer the new sb_secret_* key; legacy service_role JWTs remain accepted during migration.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_with_server_only_key
