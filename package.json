{
  "name": "wenlan-site",
  "version": "1.0.0",
  "description": "Public website and SEO/GEO surface for Wenlan, an LLM wiki for AI work.",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "postbuild": "node scripts/indexnow-ping.mjs",
    "seo:weekly": "node scripts/seo-weekly-pipeline.mjs",
    "seo:weekly:run": "node scripts/seo-weekly-pipeline.mjs",
    "seo:weekly:sample": "node scripts/seo-weekly-pipeline.mjs --input-dir scripts/fixtures/seo-weekly --allow-fixture-input true --date 2026-06-07 --output /tmp/wenlan-weekly-seo-sample.md",
    "seo:gsc:fetch": "node scripts/seo-gsc-fetch.mjs",
    "seo:vercel:fetch": "node scripts/seo-vercel-fetch.mjs",
    "seo:github:fetch": "node scripts/seo-github-fetch.mjs",
    "seo:github:traffic": "node scripts/seo-github-traffic.mjs",
    "seo:release:check": "node --import tsx scripts/release-check.mjs",
    "seo:release:bump": "node scripts/release-bump.mjs --apply",
    "seo:launch:links": "node --import tsx scripts/seo-launch-links.mjs",
    "test:launch": "node --import tsx --test scripts/launch-measurement.test.mjs",
    "seo:resend:fetch": "node scripts/seo-resend-fetch.mjs",
    "seo:goal:check": "node --import tsx scripts/seo-goal-check.mjs",
    "seo:goal:control": "node scripts/seo-goal-control.mjs",
    "seo:intent:check": "node --import tsx scripts/seo-intent-map.mjs",
    "seo:scenario:check": "node --import tsx scripts/seo-scenario-check.mjs",
    "seo:scenario:update": "node --import tsx scripts/seo-scenario-check.mjs --update",
    "seo:ai-visibility": "node scripts/seo-ai-visibility-worksheet.mjs",
    "seo:technical:built": "node scripts/seo-built-technical-check.mjs",
    "seo:technical:deployed": "node scripts/seo-deployed-technical-check.mjs",
    "resend:contact-properties:ensure": "node scripts/resend-contact-properties.mjs",
    "test:goal": "node --import tsx --test scripts/seo-goal-check.test.mjs scripts/seo-goal-control.test.mjs scripts/seo-scenario-check.test.mjs",
    "test:i18n": "node --import tsx --test scripts/i18n-contract.test.mjs",
    "i18n:technical:built": "node scripts/i18n-built-check.mjs",
    "test:seo": "node --import tsx --test scripts/home-claims.test.mjs scripts/home-layout.test.mjs scripts/workflow-guide.test.mjs scripts/hero-scenarios.test.mjs scripts/llm-wiki-worked-example.test.mjs scripts/release-check.test.mjs scripts/demo-video.test.mjs scripts/launch-measurement.test.mjs scripts/analytics-contract.test.mjs scripts/download-recommendation.test.mjs scripts/brand-contract.test.mjs scripts/app-contract.test.mjs scripts/seo-github-fetch.test.mjs scripts/seo-resend-fetch.test.mjs scripts/seo-goal-check.test.mjs scripts/seo-intent-map.test.mjs scripts/seo-scenario-check.test.mjs scripts/seo-weekly.test.mjs scripts/release-bump.test.mjs",
    "start": "next start",
    "lint": "pnpm exec tsc --noEmit --incremental false"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/7xuanlu/wenlan-site.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/7xuanlu/wenlan-site/issues"
  },
  "homepage": "https://wenlan.app",
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "geist": "^1.7.0",
    "next": "^16.2.1",
    "next-intl": "^4.13.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "resend": "^6.9.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  }
}
